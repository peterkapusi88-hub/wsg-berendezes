(setvar "FILEDIA" 0)
(setvar "CMDECHO" 0)
(defun s16-env () (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "INSUNITS" 4) (setvar "DELOBJ" 1) (command "_.UCS" "_W"))
(defun s16-layer (name col) (if (not (tblsearch "LAYER" name)) (if (= (type col) 'STR) (command "_.-LAYER" "_M" name "_C" "_T" col "" "") (command "_.-LAYER" "_M" name "_C" (itoa col) "" "")) (command "_.-LAYER" "_S" name "")) (setvar "CLAYER" name))
(defun s16-box (x y z dx dy dz) (command "_.BOX" (list x y z) (list (+ x dx) (+ y dy) (+ z dz))) (entlast))
(defun s16-lwpoly (pts / d) (setq d (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") '(100 . "AcDbPolyline") (cons 90 (length pts)) '(70 . 1))) (foreach p pts (setq d (append d (list (list 10 (car p) (cadr p)) (cons 42 (caddr p)))))) (entmake d) (entlast))
(defun s16-extrude-y (pts tt x0 y0 z0 / pl s) (setq pl (s16-lwpoly pts)) (command "_.EXTRUDE" pl "" tt) (setq s (entlast)) (command "_.ROTATE3D" s "" "_X" '(0 0 0) 90) (command "_.MOVE" s "" '(0 0 0) (list x0 y0 z0)) s)
(defun s16-sub (a b) (command "_.SUBTRACT" a "" b "") a)
(defun s16-cyl (x y z r x2 y2 z2) (command "_.CYLINDER" (list x y z) r "_A" (list x2 y2 z2)) (entlast))
(defun s16-blk (name ents / ss) (setq ss (ssadd)) (foreach e ents (if e (ssadd e ss))) (if (tblsearch "BLOCK" name) (command "_.ERASE" ss "") (command "_.-BLOCK" name '(0 0 0) ss "")) name)
(defun s16-ins (name lay pt dir rot xs) (entmake (list (cons 0 "INSERT") (cons 2 name) (cons 8 lay) (cons 10 (trans pt 0 dir)) (cons 41 xs) (cons 42 1.0) (cons 43 1.0) (cons 50 rot) (cons 210 dir))))
(defun s16-count-ins (name / ss) (setq ss (ssget "_X" (list (cons 0 "INSERT") (cons 2 name)))) (if ss (sslength ss) 0))
(defun s16-count (pre / ss i n e) (setq ss (ssget "_X" '((0 . "3DSOLID"))) i 0 n 0) (if ss (while (< i (sslength ss)) (setq e (ssname ss i)) (if (wcmatch (cdr (assoc 8 (entget e))) (strcat pre "*")) (setq n (1+ n))) (setq i (1+ i)))) n)
(defun s16-copy (e / last) (setq last (entlast)) (command "_.COPY" e "" '(0 0 0) '(0 0 0)) (entlast))
(defun s16-safe (s / r i c) (setq r "" i 1) (while (<= i (strlen s)) (setq c (substr s i 1)) (setq r (strcat r (if (member c '("$" "#")) "_" c)) i (1+ i))) r)
(defun s16-readback (dir / ss i e lay n) (setvar "FILEDIA" 0) (setq ss (ssget "_X" '((0 . "3DSOLID"))) i 0 n 0) (if ss (while (< i (sslength ss)) (setq e (ssname ss i) lay (cdr (assoc 8 (entget e)))) (if (= (substr lay 1 6) "$PART_") (progn (command "_.MASSPROP" e "" "_Y" (strcat dir "/" (s16-safe lay))) (setq n (1+ n)))) (setq i (1+ i)))) (setvar "FILEDIA" 1) (princ (strcat "\nS16 readback: " (itoa n) " test kiirva ide: " dir)) (princ))
(defun s16-smoketest ( / a b c) (s16-env) (s16-layer "$PART_SMOKE_BOX#0000" 3) (setq a (s16-box 0 -300 0 400 18 600)) (s16-layer "$PART_SMOKE_ARC#0000" 4) (setq c (s16-extrude-y (list (list 0 0 0) (list 100 0 0.414213562) (list 200 100 0) (list 200 200 0) (list 0 200 0)) 18 600 -18 0)) (s16-layer "$PART_SMOKE_SUB#0000" 5) (setq a (s16-box 1000 -300 0 400 18 600)) (setq b (s16-box 1100 -310 100 200 38 400)) (s16-sub a b) (command "_.ZOOM" "_E") (princ "\nS16 smoketest kesz: 3 test. Futtasd: (s16-readback \"<mappa>\")") (princ))
(s16-smoketest)
(s16-readback "/Users/peterkapusi/CAD/S16_R15/readback_smoke")
(command "_.SAVEAS" "2018" "/Users/peterkapusi/CAD/S16_R15/S16_R15C_smoke.dwg")
(princ "S16_SAVE_DONE")
_.QUIT
_Y
